{
  "name": "@gadgets/gatekeeper-process",
  "version": "1.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./graph-ops": "./src/graph-ops.ts",
    "./coverage": "./src/coverage.ts",
